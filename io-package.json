  "common": {
    "name": "freeair100",
    "version": "0.5.2",
    "news": {
      "0.5.2": {
        "en": "Discovery: values.php returns AES-encrypted array (not plain object). Array handling added, AES key from freeair.js needed.",
        "de": "Entdeckung: values.php liefert AES-verschluesseltes Array (kein einfaches Objekt). Array-Behandlung ergaenzt, AES-Schluessel aus freeair.js benoetigt."
      },
      "0.5.1": {
        "en": "Fix: wrong password detected after single 401 - no retry to prevent Code 9. Clear error message.",
        "de": "Fix: Falsches Passwort nach 401 erkannt - kein Retry um Code-9 zu vermeiden. Klare Fehlermeldung."
      },
      "0.5.0": {
        "en": "First stable release: full auth flow, JSON API, device control, Code-9 protection, connection test, updated README",
        "de": "Erste stabile Version: vollstaendiger Auth-Flow, JSON-API, Geraetesteuerung, Code-9-Schutz, Verbindungstest, aktualisiertes README"
      },
      "0.4.8": {
        "en": "Fix: connection test now shows result with emoji status, SN check, better error messages",
        "de": "Fix: Verbindungstest zeigt Ergebnis mit Emoji-Status, SN-Pruefung, bessere Fehlermeldungen"
      },
      "0.4.7": {
        "en": "Fix: removed outdated TBD control notices - control via /api/button.php is fully implemented",
        "de": "Fix: veraltete TBD-Hinweise entfernt - Steuerung via /api/button.php ist vollstaendig implementiert"
      },
      "0.4.6": {
        "en": "Fix: Code 9 block survives restart (persistent state), block-aware retry, connection test button in admin",
        "de": "Fix: Code-9-Sperre ueberlebt Neustart (State), blockierter Retry, Verbindungstest-Button im Admin"
      },
      "0.4.5": {
        "en": "Fix: Code 9 block detection (1h), complete field mapping from language.php analysis",
        "de": "Fix: Code 9 Sperrung erkennen (1h), vollstaendiges Key-Mapping aus language.php Analyse"
      },
      "0.4.4": {
        "en": "Fix: login POST now sends existing session cookie to upgrade anonymous session to authenticated",
        "de": "Fix: Login-POST sendet bestehenden Session-Cookie mit, damit Server anonymous Session zu authenticated hochstuft"
      },
      "0.4.3": {
        "en": "Fix: correct API paths /api/values.php and /api/button.php (discovered via DevTools)",
        "de": "Fix: korrekte API-Pfade /api/values.php und /api/button.php (via DevTools ermittelt)"
      },
      "0.4.2": {
        "en": "Root fix: data loaded from values.php JSON API (not HTML parsing). Discovered via DevTools XHR.",
        "de": "Root-Fix: Daten direkt von values.php JSON-API (kein HTML-Parsing mehr). Entdeckt via DevTools XHR."
      },
      "0.4.1": {
        "en": "Fix: auth detection checked for id=nav4 which exists in all responses - now checks for actual data rows (<th>BA</th>)",
        "de": "Fix: Auth-Erkennung pruefte auf id=nav4 (in ALLEN Responses vorhanden) - jetzt Pruefung auf echte Datensaetze (<th>BA</th>)"
      },
      "0.4.0": {
        "en": "Authentication: login with password to freeair-connect.de, session cookie, real device control via POST",
        "de": "Authentifizierung: Login mit Passwort bei freeair-connect.de, Session-Cookie, echte Geraetesteuerung via POST CL/OM"
      },
      "0.3.9": {
        "en": "Fix: JS.join crash (JS was string not array), better parse error logging",
        "de": "Fix: JS.join Crash (JS war String statt Array), besseres Parse-Fehler-Logging"
      },
      "0.3.8": {
        "en": "Root-fix: all 47 states moved to io-package.json instanceObjects, removed _initStates() from onReady completely",
        "de": "Root-Fix: alle 47 States in io-package.json instanceObjects, _initStates() aus onReady entfernt - kein Startup-Timeout mehr"
      },
      "0.3.7": {
        "en": "Robustness: module.parent export, EADDRINUSE error message, this.config null guards everywhere",
        "de": "Stabilitaet: module.parent Export, EADDRINUSE Fehlermeldung, this.config null-Guards ueberall"
      },
      "0.3.6": {
        "en": "JS browser fixes: JS.join, tabs.indexOf null-safe, fetch catch, timer guard, logs limit 150",
        "de": "Browser-JS Fixes: JS.join statt Array+String, tabs.indexOf null-sicher, fetch catch, Timer-Guard, Logs-Limit 150"
      },
      "0.3.5": {
        "en": "Critical fix: parallel Promise.all for extendObjectAsync (serial await caused startup SIGKILL timeout)",
        "de": "Kritischer Fix: paralleles Promise.all fuer extendObjectAsync (serielles await verursachte Startup-Timeout SIGKILL)"
      },
      "0.3.4": {
        "en": "Critical bugfix: JSON.stringify(this.config) crashed onReady; wrapped in try/catch",
        "de": "Kritischer Bugfix: JSON.stringify(this.config) crashte onReady; in try/catch eingebettet"
      },
      "0.3.3": {
        "en": "Critical bugfix: removed await setStateAsync from onReady start (caused SIGKILL on startup)",
        "de": "Kritischer Bugfix: await setStateAsync am Anfang von onReady entfernt (verursachte SIGKILL beim Start)"
      },
      "0.3.2": {
        "en": "DEBUG version: 91 debug log points in all methods for diagnostics",
        "de": "DEBUG-Version: 91 Debug-Logpunkte in allen Methoden zur Fehlerdiagnose"
      },
      "0.3.1": {
        "en": "Bugfix: jsonConfig header size required, onReady setState timing fix",
        "de": "Bugfix: jsonConfig header size Pflichtfeld, onReady setState Timing korrigiert"
      },
      "0.3.0": {
        "en": "Bugfix: adapter-core v3 export pattern, jsonConfig defaultValue->default",
        "de": "Bugfix: adapter-core v3 Export-Pattern, jsonConfig defaultValue->default, ungueltige Felder entfernt"
      },
      "0.2.0": {
        "en": "Beautiful dashboard with SVG flow diagram, arc gauges, filter countdown ring",
        "de": "Schönes Dashboard: SVG-Strömungsdiagramm, Bogen-Gauges, Filter-Countdown-Ring"
      },
      "0.1.0": {
        "en": "Initial release: Cloud scraping, 40+ states, web UI",
        "de": "Erstveröffentlichung: Cloud-Scraping, 40+ States, Web-UI"
      }
    },
    "title": "freeAir 100",
    "titleLang": {
      "de": "freeAir 100 Lüftungsanlage",
      "en": "freeAir 100 Ventilation"
    },
    "desc": {
      "de": "Liest alle Messwerte des bluMartin freeAir 100 Lüftungsgeräts über freeair-connect.de. Dashboard mit Strömungsdiagramm, Gauges und Filterwechsel-Countdown.",
      "en": "Reads all data from the bluMartin freeAir 100 ventilation unit via freeair-connect.de. Dashboard with flow diagram, gauges and filter change countdown."
    },
    "authors": [
      "MPunktBPunkt"
    ],
    "keywords": [
      "freeair",
      "freeair100",
      "lueftung",
      "ventilation",
      "blumartin",
      "hvac"
    ],
    "license": "MIT",
    "type": "general",
    "mode": "daemon",
    "platform": "Node.js",
    "main": "main.js",
    "icon": "admin/freeair100.svg",
    "enabled": true,
    "loglevel": "info",
    "readme": "https://github.com/MPunktBPunkt/iobroker.freeair100/blob/main/README.md",
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ],
    "connectionType": "cloud",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    }
  },
