{
  "type": "panel",
  "items": {
    "_h1": {
      "type": "header",
      "text": "freeAir Verbindung",
      "size": 2
    },
    "serialnumber": {
      "type": "text",
      "label": "Seriennummer (z.B. 20573)",
      "help": "Seriennummer Ihres freeAir 100 Geraets - steht auf dem Geraet und im freeAir Connect Portal"
    },
    "password": {
      "type": "password",
      "label": "Passwort (freeAir Connect)",
      "help": "Passwort fuer den Login auf freeair-connect.de. Wird benoetigt um Daten abzurufen."
    },
    "connectionTest": {
      "type": "sendTo",
      "label": "Verbindung testen",
      "command": "test",
      "jsonData": "{\"serialnumber\": \"${data.serialnumber}\", \"password\": \"${data.password}\"}",
      "result": {
        "type": "staticText",
        "text": ""
      }
    },
    "_h2": {
      "type": "header",
      "text": "Abfrage",
      "size": 2
    },
    "pollInterval": {
      "type": "number",
      "label": "Abfrage-Intervall (Sekunden)",
      "help": "Wie oft freeair-connect.de abgefragt wird. Empfehlung: 300s (5 min)",
      "min": 30,
      "max": 3600,
      "default": 300
    },
    "_h3": {
      "type": "header",
      "text": "Filterwechsel",
      "size": 2
    },
    "filterChangeIntervalH": {
      "type": "number",
      "label": "Filterwechsel-Intervall (Stunden)",
      "help": "Nach wie vielen Betriebsstunden der Filter gewechselt werden soll. Standard: 8760h = 1 Jahr",
      "min": 100,
      "max": 17520,
      "default": 8760
    },
    "_h4": {
      "type": "header",
      "text": "Web-Interface",
      "size": 2
    },
    "webPort": {
      "type": "number",
      "label": "Web-UI Port",
      "help": "Port fuer das integrierte Dashboard",
      "min": 1024,
      "max": 65535,
      "default": 8096
    },
    "_h5": {
      "type": "header",
      "text": "Erweitert",
      "size": 2
    },
    "logBuffer": {
      "type": "number",
      "label": "Max. Log-Eintraege",
      "min": 50,
      "max": 5000,
      "default": 500
    },
    "verbose": {
      "type": "checkbox",
      "label": "Debug-Logging aktivieren",
      "default": false
    }
  }
}